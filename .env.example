# Legacy local OpenAI-compatible configuration (optional alternative to LLM_*).
# LOCAL_LLM_URL="http://127.0.0.1:1234/v1/chat/completions"
# LOCAL_LLM_MODEL="your-local-model"

# groq, openai, anthropic, local, or openai-compatible.
# A provider is required for interpretation; none holds new messages for review.
# Switch provider + model + key together. Keep real keys in .env only.
# Leave unset to retain legacy LOCAL_LLM_* configuration above.
# LLM_PROVIDER="groq"
# LLM_MODEL="MODEL_ID_FROM_PROVIDER"
# LLM_API_KEY=""
# Only local/openai-compatible: complete endpoint, not just a base URL.
# LLM_URL="https://your-provider.example/v1/chat/completions"
